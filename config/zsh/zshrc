# ~/.zshrc  (managed by hnp-dotfiles — symlinked from config/zsh/zshrc)
# Portable config only. Machine-specific paths + SECRETS go in ~/.config/zsh/local.zsh
# (gitignored; copy from local.zsh.example).

# ---- oh-my-zsh ----
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"        # overridden by starship below; kept for omz internals
plugins=(git)
[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ---- PATH (portable) ----
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# ---- editor (nvim) ----
export EDITOR=nvim
export VISUAL=nvim

# ---- modular config from this repo ----
ZDOTREPO="${ZDOTREPO:-$HOME/.config/zsh}"
for f in exports aliases functions; do
  [ -r "$ZDOTREPO/$f.zsh" ] && source "$ZDOTREPO/$f.zsh"
done

# ---- tools (load if present) ----
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init zsh)"
if command -v kubectl >/dev/null 2>&1; then source <(kubectl completion zsh); fi

# ---- machine-specific overrides + secrets (not in git) ----
[ -r "$ZDOTREPO/local.zsh" ] && source "$ZDOTREPO/local.zsh"
