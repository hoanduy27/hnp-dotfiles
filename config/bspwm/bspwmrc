#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

pgrep -x dunst > /dev/null || dunst &

# disable middle-click (button 2) to stop primary-selection paste
xinput set-button-map "SynPS/2 Synaptics TouchPad" 1 0 3 4 5 6 7 2>/dev/null
xinput set-button-map "Genius Wireless Dongle" 1 0 3 4 5 6 7 8 9 2>/dev/null
# Terminate already running plank
killall -q plank
plank &

~/.config/bspwm/monitor-hotplug.sh &
~/.config/bspwm/plank.sh &
pgrep -f dynamic-desktops.sh > /dev/null || ~/.config/bspwm/dynamic-desktops.sh &

bspc config border_width         2
bspc config window_gap           1

bspc config split_ratio          0.52
bspc config borderless_monocle   false
bspc config gapless_monocle      true
bspc config focused_border_color "#7AE2CF"

bspc rule -a Gimp desktop='gimp' state=floating follow=on
bspc rule -a Chromium desktop='web'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a scpad sticky=on state=floating rectangle=1080x640+0+0 center=true
bspc rule -a polybar-popup sticky=on state=floating rectangle=1080x640+420+250
bspc rule -a power sticky=on state=floating
bspc rule -a ffplay sticky=on state=floating rectangle=100x20+10+1
bspc rule -a clipboard sticky=on state=floating
bspc rule -a clipboard sticky=on state=floating
bspc rule -a kdeconnectd state=floating
bspc rule -a pavucontrol state=floating rectangle=800x600+600+220
bspc rule -a '*:*:Picture-in-Picture' state=floating sticky=on rectangle=300x200+300+200

sxhkd &

# --- bar: eww (was polybar: $HOME/.config/polybar/launch.sh) ---
$HOME/.config/eww/launch-eww.sh &
picom &
# feh --bg-fill --randomize ~/Pictures/Wallpapers/*
~/.config/bspwm/change_wallpaper.sh &>/dev/null &

bspc rule -a Dmenu state=floating

ibus-daemon -rxRd
~/.local/scripts/clipboard.sh monitor &
