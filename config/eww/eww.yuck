;; =====================================================================
;;  eww bar — port of the bspwm/polybar setup (teal #005550 vibe)
;;  Layout mirrors polybar:
;;    bar-left   : notification date configure reload wallpaper  workspaces  window
;;    bar-right  : backlight wlan memory cpu filesystem battery power
;;    bar-bottom : bluetooth pulseaudio cava nowplaying
;; =====================================================================

;; ---------- data sources ----------
(deflisten workspaces :initial "[]" "${EWW_CONFIG_DIR}/scripts/workspaces.sh")
(deflisten window     :initial ""   "${EWW_CONFIG_DIR}/scripts/window.sh")
(deflisten cava       :initial ""   "${EWW_CONFIG_DIR}/scripts/cava-eww.sh")
(deflisten nowplaying :initial ""   "${EWW_CONFIG_DIR}/scripts/nowplaying.sh")

(defpoll clock     :interval "10s" :initial "" "${EWW_CONFIG_DIR}/scripts/sysinfo.sh date")
(defpoll cpu       :interval "2s"  :initial "0"  "${EWW_CONFIG_DIR}/scripts/sysinfo.sh cpu")
(defpoll mem       :interval "3s"  :initial "0"  "${EWW_CONFIG_DIR}/scripts/sysinfo.sh mem")
(defpoll fs        :interval "30s" :initial "0"  "${EWW_CONFIG_DIR}/scripts/sysinfo.sh fs")
(defpoll bat       :interval "10s" :initial '{"cap":0,"charging":false,"present":false}' "${EWW_CONFIG_DIR}/scripts/sysinfo.sh bat")
(defpoll backlight :interval "5s"  :initial "0"  "${EWW_CONFIG_DIR}/scripts/sysinfo.sh backlight")
(defpoll vol       :interval "1s"  :initial '{"vol":0,"muted":false}' "${EWW_CONFIG_DIR}/scripts/volume.sh get")
(defpoll wifi      :interval "5s"  :initial '{"icon":"","label":"...","up":false}' "${EWW_CONFIG_DIR}/scripts/net.sh wifi")
(defpoll bt        :interval "5s"  :initial '{"on":false,"connected":false,"label":"off"}' "${EWW_CONFIG_DIR}/scripts/net.sh bt")
(defpoll notif     :interval "3s"  :initial "0"  "${EWW_CONFIG_DIR}/scripts/notification.sh")

;; ---------- small widgets ----------
(defwidget pill [?class]
  (box :class "pill ${class ?: ""}" :space-evenly false :valign "center"
    (children)))

(defwidget workspaces-w []
  (box :class "mod workspaces" :space-evenly false :valign "center"
    (for ws in workspaces
      (button :class "ws ${ws.focused ? "focused" : ""} ${ws.occupied ? "occupied" : "empty"} ${ws.urgent ? "urgent" : ""}"
              :onclick "bspc desktop -f ${ws.name}"
        "${ws.focused ? "" : (ws.occupied ? "" : "")}"))))

(defwidget window-w []
  (label :class "mod window" :halign "start" :limit-width 60 :text {window}))

(defwidget clock-w []
  (button :class "mod clock" :onclick "${EWW_CONFIG_DIR}/scripts/popup-powermenu.sh &"
    "  ${clock}"))

(defwidget notif-w []
  (button :class "mod notif ${notif != "0" ? "has" : ""}"
          :onclick "dunstctl history-pop"
    "${notif != "0" ? "" : ""}"))

(defwidget iconbtn [icon tip cmd ?class]
  (button :class "mod iconbtn ${class ?: ""}" :tooltip tip :onclick cmd icon))

;; right cluster modules
(defwidget backlight-w []
  (box :class "mod backlight" :space-evenly false
    (label :text "")
    (label :text " ${backlight}%")))

(defwidget wifi-w []
  (button :class "mod wifi ${wifi.up ? "up" : "down"}"
          :onclick "${EWW_CONFIG_DIR}/scripts/wifi.sh toggle &"
    "${wifi.icon}  ${wifi.label}"))

(defwidget mem-w [] (box :class "mod mem" :space-evenly false (label :text "") (label :text " ${mem}%")))
(defwidget cpu-w [] (box :class "mod cpu" :space-evenly false (label :text "") (label :text " ${cpu}%")))
(defwidget fs-w  [] (box :class "mod fs"  :space-evenly false (label :text "") (label :text " ${fs}%")))

(defwidget battery-w []
  (box :class "mod battery ${bat.charging ? "charging" : ""} ${bat.cap <= 15 && !bat.charging ? "low" : ""}"
       :space-evenly false :visible {bat.present}
    (label :text {bat.charging ? "" :
                  (bat.cap >= 90 ? "" :
                  (bat.cap >= 60 ? "" :
                  (bat.cap >= 40 ? "" :
                  (bat.cap >= 15 ? "" : ""))))})
    (label :text " ${bat.cap}%")))

(defwidget power-w []
  (button :class "mod power" :onclick "${EWW_CONFIG_DIR}/scripts/powermenu.sh &" ""))

;; bottom bar modules
(defwidget bt-w []
  (button :class "mod bt ${bt.on ? "on" : "off"} ${bt.connected ? "connected" : ""}"
          :onclick "${EWW_CONFIG_DIR}/scripts/bluetooth.sh toggle &"
    "${bt.on ? "" : ""}  ${bt.label}"))

(defwidget vol-w []
  (button :class "mod vol ${vol.muted ? "muted" : ""}"
          :onclick "${EWW_CONFIG_DIR}/scripts/volume.sh toggle"
          :onscroll "${EWW_CONFIG_DIR}/scripts/volume.sh {} >/dev/null"
    "${vol.muted ? "" : (vol.vol >= 50 ? "" : (vol.vol > 0 ? "" : ""))}  ${vol.vol}%"))

(defwidget cava-w []
  (label :class "mod cava" :text {cava}))

(defwidget nowplaying-w []
  (button :class "mod nowplaying" :onclick "playerctl play-pause"
          :limit-width 45 :visible {nowplaying != ""}
    "${nowplaying}"))

;; ---------- bars ----------
(defwidget bar-left-c []
  (box :class "bar bar-left" :space-evenly false :valign "center"
    (pill :class "left-cluster"
      (notif-w)
      (clock-w)
      (iconbtn :icon "" :tip "settings" :cmd "${EWW_CONFIG_DIR}/scripts/show-apps.sh &")
      (iconbtn :icon "" :tip "reload" :cmd "eww reload")
      (iconbtn :icon "" :tip "wallpaper" :cmd "~/.config/bspwm/change_wallpaper.sh &"))
    (pill :class "ws-pill" (workspaces-w))
    (window-w)))

(defwidget bar-right-c []
  (box :class "bar bar-right" :halign "end" :space-evenly false :valign "center"
    (pill :class "right-cluster"
      (backlight-w) (wifi-w) (mem-w) (cpu-w) (fs-w) (battery-w) (power-w))))

(defwidget bar-bottom-c []
  (box :class "bar bar-bottom" :halign "center" :space-evenly false :valign "center"
    (pill :class "bottom-cluster"
      (bt-w) (vol-w) (cava-w) (nowplaying-w))))

;; ---------- windows ----------
(defwindow bar-left
  :monitor 0
  :geometry (geometry :x "5%" :y "2px" :width "30%" :height "22px" :anchor "top left")
  :stacking "fg" :windowtype "dock" :exclusive false
  (bar-left-c))

(defwindow bar-right
  :monitor 0
  :geometry (geometry :x "1%" :y "2px" :width "63%" :height "22px" :anchor "top right")
  :stacking "fg" :windowtype "dock" :exclusive false
  (bar-right-c))

(defwindow bar-bottom
  :monitor 0
  :geometry (geometry :x "0%" :y "2px" :width "50%" :height "20px" :anchor "bottom center")
  :stacking "fg" :windowtype "dock" :exclusive false
  (bar-bottom-c))
