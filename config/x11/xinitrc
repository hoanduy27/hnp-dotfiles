#!/bin/sh
# ~/.xinitrc — launched by `startx`. Starts bspwm, which in turn sources
# ~/.config/bspwm/bspwmrc (that file starts sxhkd, picom, eww, etc.).

# merge X resources / keymaps if present
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# input method (bspwmrc also calls ibus-daemon; harmless if repeated)
export GTK_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export QT_IM_MODULE=ibus

export XDG_SESSION_TYPE=x11

exec bspwm
