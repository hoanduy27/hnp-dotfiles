[global]
    follow = keyboard
    origin = top-center
    offset = (0, 30)
    separator_height = 2
    font = "Ubuntu Nerd Font:style=Regular" 10

[urgency_low]
    timeout = 5
    background = "#7AE2CF88"
    foreground = "#c5c8c6"

[urgency_normal]
    timeout = 8
    background = "#7AE2CF88"
    foreground = "#c5c8c6"

[urgency_critical]
    timeout = 15
    background = "#7AE2CF88"
    foreground = "#df4545"
